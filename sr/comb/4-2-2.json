{"data":{"Year":[2010,2011,2012,2016,2017,2018,2019,2020,2021,2022,2010,2011,2012,2016,2017,2018,2019,2020,2021,2022,2010,2011,2012,2016,2017,2018,2019,2020,2021,2022],"SERIES":["\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u043f\u0440\u0438j\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u0437\u0430 \u0443\u043f\u0438\u0441 \u0443 \u043e\u0441\u043d\u043e\u0432\u043d\u0443 \u0448\u043a\u043e\u043b\u0443), \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","\u0421\u0442\u043e\u043f\u0430 \u0443\u0447\u0435\u0448\u045b\u0430 \u0443 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 (\u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u0430\u043d\u0430 \u
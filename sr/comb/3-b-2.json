u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430, \u043f\u043e \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0430 2023.)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0438\u043c\u0430 \u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430, \u043d\u0435\u044
{"data":{"Year":[2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022],"SERIES":["\u0423\u043a\u0443\u043f\u043d\u0438 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0438 \u0442\u043e\u043a\u043e\u0432\u0438 \u0437\u0430 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443, \u043f\u0440\u0435\u043c\u0430 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438\u0445 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u0438\u0437 2023. \u0433\u043e\u0434\u0438\u043d\u0435)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0438 \u0442\u043e\u043a\u043e\u0432\u0438 \u0437\u0430 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443, \u043f\u0440\u0435\u043c\u0430 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438\u0445 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u0438\u0437 2023. \u0433\u043e\u0434\u0438\u043d\u0435)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0438 \u0442\u043e\u043a\u043e\u0432\u0438 \u0437\u0430 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443, \u043f\u0440\u0435\u043c\u0430 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438\u0445 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u0438\u0437 2023. \u0433\u043e\u0434\u0438\u043d\u0435)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0438 \u0442\u043e\u043a\u043e\u0432\u0438 \u0437\u0430 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443, \u043f\u0440\u0435\u043c\u0430 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438\u0445 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u0438\u0437 2023. \u0433\u043e\u0434\u0438\u043d\u0435)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0438 \u0442\u043e\u043a\u043e\u0432\u0438 \u0437\u0430 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443, \u043f\u0440\u0435\u043c\u0430 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438\u0445 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u0438\u0437 2023. \u0433\u043e\u0434\u0438\u043d\u0435)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0438 \u0442\u043e\u043a\u043e\u0432\u0438 \u0437\u0430 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443, \u043f\u0440\u0435\u043c\u0430 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043f\u0440\u0438\u043c\u0430\u043e\u0446\u0438\u043c\u0430 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438\u0445 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u0438\u0437 2023. \u0433\u043e\u0434\u0438\u043d\u0435)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0438 \u0442\u043e\u043a\u043e\u0432\u0438 \u0437\u0430 \u0438
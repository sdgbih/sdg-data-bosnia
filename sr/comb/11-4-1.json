0\u0432\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0442\u0440\u043e\u0448\u043a\u043e\u0432\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0442\u0440\u043e\u0448\u043a\u043e\u0432\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0442\u0440\u043e\u0448\u043a\u043e\u0432\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0442\u0440\u043e\u0448\u043a\u043e\u0432\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u043e \u043d\u0430\u0441\u043b\u0438\u0458\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u043d\u0430\u0441\u043b\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 \u0438\u0437 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u043d\u0430\u0441\u043b\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 \u0438\u0437 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u043d\u0430\u0441\u043b\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 \u0438\u0437 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u0435\u043d\u0438 \u043d\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u043d\u043e \u043d\u0430\u0441\u043b\u0435\u0452\u0435, \u0458\u0430\u0432\u043d\u043e \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e (\u041f\u041f\u041f, \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u043e\u043b\u0430\u0440\u0438 \u0438\u0437 2017.)","\u0423\u043a\u0443\u043f\u043d\u0438 \u0438\u0437\u0434\u0430\u0446\u0438 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448
3a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u0438\u0437 2023. \u0433\u043e\u0434\u0438\u043d\u0435)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b (\u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430) \u0437\u0430 \u0442\u0435\u0445\u043d\u0438\u0447\u043a\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u0438\u0437 2023. \u0433\u043e\u0434\u0438\u043d\u0435)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b (\u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430) \u0437\u0430 \u0442\u0435\u0445\u043d\u0438\u0447\u043a\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u0438\u0437 2023. \u0433\u043e\u0434\u0438\u043d\u0435)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b (\u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430) \u0437\u0430 \u0442\u0435\u0445\u043d\u0438\u0447\u043a\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443 (\u043c\u0438\u043b\u0438\u043e\u043d\u0438 \u0430\u043c\u0435\u0440\u0438\u0447\u043a\u0438\u0445 \u0434\u043e\u043b\u0430\u0440\u0430 \u0438\u0437 2023. \u0433\u043e\u0434\u0438\u043d\u0435)","\u0423\u043a\u0443\u043f\u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b (\u0431\u0440\u0443\u0442\u043e \u0438\u0441\u043f\u043b\u0430\u0442\u0430) \u0437\u0430 \u0442\u